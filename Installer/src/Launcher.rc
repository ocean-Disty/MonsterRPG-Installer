/* Resources for MonsterRPG.exe */

#include <windows.h>
#include "Resource.h"

1 RT_MANIFEST "app.manifest"

IDI_APP ICON "MonsterRPG.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      COMPANY_NAME
            VALUE "FileDescription",  "Start Blockland with MonsterRPG"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "MonsterRPG"
            VALUE "OriginalFilename", "Blockland MonsterRPG.exe"
            VALUE "ProductName",      PRODUCT_NAME
            VALUE "ProductVersion",   VER_STRING
            VALUE "LegalCopyright",   "MonsterRPG"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
